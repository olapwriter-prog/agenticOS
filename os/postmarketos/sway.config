# The phone's screen: sway with two full-screen workspaces. Workspace 1 holds agentos-ui (the
# agent's home); workspace 2 holds the Waydroid window while an Android app is open.
# Start with the agentd-ui service; it logs the screen user in and runs sway with this file.
output * bg #121317 solid_color
default_border none
default_floating_border none

# agentos-ui fills workspace 1
for_window [app_id="agentos-ui"] move to workspace number 1, fullscreen enable
workspace 1
exec agentos-ui

# every Waydroid window goes full screen to workspace 2
for_window [app_id="Waydroid"] move to workspace number 2, fullscreen enable
for_window [title="Waydroid"] move to workspace number 2, fullscreen enable

# the on-screen keyboard, hidden until a text field asks for it
exec wvkbd-mobintl -H 300 --hidden

# a long press of volume-down goes back to the Home screen
bindsym --release XF86AudioLowerVolume exec swaymsg workspace number 1
