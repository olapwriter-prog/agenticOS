# Maintainer: M V Raghunadh <olapwriter@gmail.com>
#
# agentd for postmarketOS: the whole phone as one headless, agent-driven daemon.
# Build from a local checkout with:
#   pmbootstrap build agentd --arch aarch64 --src=/path/to/agenticOS
pkgname=agentd
pkgver=0.1.0
pkgrel=0
pkgdesc="Agentic OS: a headless phone driven by an on-device LLM agent (calls, SMS, Wi-Fi, MCP)"
url="https://github.com/olapwriter-prog/agenticOS"
arch="aarch64 armv7 x86_64"
license="Apache-2.0"
# The phone's hardware is reached through these services; agentd shells out to their CLIs.
depends="
	callaudiod
	dbus
	feedbackd
	modemmanager
	networkmanager
	networkmanager-cli
	networkmanager-wifi
	networkmanager-wwan
	pipewire
	wireplumber
	wpa_supplicant
	"
# The local LLM: Alpine's llama.cpp, with the Vulkan GPU backend. Alpine does not build it for
# 32-bit ARM, so armv7 phones run without a local model (intents and the commercial model only).
case "$CARCH" in
	aarch64|x86_64) depends="$depends llama-server libggml-cpu libggml-vulkan" ;;
esac
# rust-wasm: the script runtime (Rhai) is compiled to WebAssembly and embedded in agentd.
makedepends="cargo cargo-auditable rust-wasm"
subpackages="$pkgname-openrc"
source="$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz
	agentd.initd
	agentd.confd
	agentd.toml
	"
builddir="$srcdir/agenticOS-$pkgver"
options="net" # cargo fetches crates

prepare() {
	default_prepare
	# Alpine ships its own rustc; the pinned toolchain file is for developer machines.
	rm -f rust-toolchain.toml
	cargo fetch --target="$CTARGET" --locked
	cargo fetch --target=wasm32-unknown-unknown --locked
}

build() {
	# the script runtime is built by a nested cargo, which must stay offline too
	export CARGO_NET_OFFLINE=true
	cargo auditable build --release --frozen -p agentd
}

check() {
	export CARGO_NET_OFFLINE=true
	cargo test --frozen -p agentos-phone -p agentos-prio -p agentos-models \
		-p agentos-script-guest -p agentos-scripts -p agentd
}

package() {
	install -Dm755 target/release/agentd "$pkgdir"/usr/bin/agentd
	install -Dm644 "$srcdir"/agentd.toml "$pkgdir"/etc/agentd/agentd.toml
	install -Dm755 "$srcdir"/agentd.initd "$pkgdir"/etc/init.d/agentd
	install -Dm644 "$srcdir"/agentd.confd "$pkgdir"/etc/conf.d/agentd
	install -dm700 "$pkgdir"/var/lib/agentd
	install -dm700 "$pkgdir"/var/lib/agentd/models
}

# Generated, one line per source file: run `pmbootstrap checksum agentd` (or `abuild checksum`)
# after copying this directory into pmaports, and again for each release tarball.
sha512sums=""
