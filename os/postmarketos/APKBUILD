# Maintainer: M V Raghunadh <olapwriter@gmail.com>
#
# agentd for postmarketOS: the whole phone as one headless, agent-driven daemon.
# Build from a local checkout with:
#   pmbootstrap build agentd --arch aarch64 --src=/path/to/agenticOS
pkgname=agentd
pkgver=0.1.0
pkgrel=0
pkgdesc="Agentic OS: a headless phone driven by an on-device LLM agent (calls, SMS, Wi-Fi, MCP)"
url="https://github.com/olapwriter-prog/agenticOS"
arch="aarch64 armv7 x86_64"
license="Apache-2.0"
# The phone's hardware is reached through these services; agentd shells out to their CLIs.
# Checked against Alpine edge aarch64 (2026-11-10): callaudiocli is its own package (not in
# callaudiod); dbus-monitor ships in dbus; feedbackd's udev rules (LEDs to the feedbackd group,
# vibration motors) are feedbackd-udev, pulled in explicitly rather than by install_if udev.
depends="
	callaudiod
	callaudiocli
	dbus
	evtest
	feedbackd
	feedbackd-udev
	modemmanager
	networkmanager
	networkmanager-cli
	networkmanager-wifi
	networkmanager-wwan
	pipewire
	pipewire-pulse
	wireplumber
	wpa_supplicant
	rust
	rust-wasm
	"
# The local LLM runs on agentos-llm, this package's own engine (crates/infer): CPU, NEON SDOT
# kernels on aarch64, portable elsewhere, so armv7 phones get a local model too. llama.cpp's
# llama-server also works (apk add llama-server; set llama_server in agentd.toml).
# rust and rust-wasm are runtime dependencies too: the agent writes its functions in Rust, and
# agentd compiles them with rustc to WebAssembly for the sandbox. (check() compiles some.)
makedepends="cargo cargo-auditable rust-wasm"
subpackages="$pkgname-openrc $pkgname-ui:ui"
install="$pkgname.pre-install"
source="$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz
	agentd.initd
	agentd.confd
	agentd.toml
	agentd-session.initd
	agentd-session.sh
	agentd-ui.initd
	sway.config
	"
builddir="$srcdir/agenticOS-$pkgver"
options="net" # cargo fetches crates

prepare() {
	default_prepare
	# Alpine ships its own rustc; the pinned toolchain file is for developer machines.
	rm -f rust-toolchain.toml
	cargo fetch --target="$CTARGET" --locked
}

build() {
	cargo auditable build --release --frozen -p agentd -p agentos-infer --bins
	# the skill library: Google, Microsoft, OpenAI, Anthropic and Vercel skill guides at the
	# commits in skills/sources.tsv, only those whose license allows redistribution
	cargo auditable build --release --frozen -p agentos-skillpack
	cargo auditable build --release --frozen -p agentos-apps --bin agentos-apps-check
	# the screen: its own workspace; it fetches Rune from git at a pinned revision, so this step
	# needs network access (options="net" above)
	(cd ui && cargo build --release)
	sh scripts/fetch-skills.sh "$builddir/skillpack" "$srcdir/skill-sources"
}

check() {
	cargo test --frozen -p agentos-phone -p agentos-prio -p agentos-models \
		-p agentos-functions -p agentos-infer -p agentd
}

package() {
	install -Dm755 target/release/agentd "$pkgdir"/usr/bin/agentd
	install -Dm755 target/release/agentos-llm "$pkgdir"/usr/bin/agentos-llm
	# calls every app once against the live public APIs: run it on the phone once it is online
	install -Dm755 target/release/agentos-apps-check "$pkgdir"/usr/bin/agentos-apps-check
	install -Dm644 "$srcdir"/agentd.toml "$pkgdir"/etc/agentd/agentd.toml
	install -Dm755 "$srcdir"/agentd.initd "$pkgdir"/etc/init.d/agentd
	install -Dm644 "$srcdir"/agentd.confd "$pkgdir"/etc/conf.d/agentd
	# the user session for call audio, vibration and volume (user made by agentd.pre-install)
	install -Dm755 "$srcdir"/agentd-session.initd "$pkgdir"/etc/init.d/agentd-session
	install -Dm755 "$srcdir"/agentd-session.sh "$pkgdir"/usr/libexec/agentd/agentd-session
	# Phase 5 bring-up: checks for this phone and the guided run with a second phone
	install -Dm755 scripts/phone-preflight.sh "$pkgdir"/usr/share/agentd/phone-preflight.sh
	install -Dm644 os/catalog/catalog.toml "$pkgdir"/usr/share/agentd/catalog.toml
	install -Dm755 scripts/phone-scenarios.sh "$pkgdir"/usr/share/agentd/phone-scenarios.sh
	install -Dm755 scripts/phone-bench.sh "$pkgdir"/usr/share/agentd/phone-bench.sh
	install -dm700 "$pkgdir"/var/lib/agentd
	install -dm700 "$pkgdir"/var/lib/agentd/models
	cp -r "$builddir"/skillpack "$pkgdir"/var/lib/agentd/skills
	install -Dm644 skills/sources.tsv "$pkgdir"/usr/share/doc/agentd/skill-sources.tsv
}

# The screen: agentos-ui full screen under sway, with the Waydroid window beside it on workspace 2.
ui() {
	pkgdesc="agentOS screen: agentos-ui in sway, with the on-screen keyboard"
	depends="$pkgname sway seatd wvkbd"
	install -Dm755 "$builddir"/ui/target/release/agentos-ui "$subpkgdir"/usr/bin/agentos-ui
	install -Dm644 "$srcdir"/sway.config "$subpkgdir"/etc/agentd/sway.config
	install -Dm755 "$srcdir"/agentd-ui.initd "$subpkgdir"/etc/init.d/agentd-ui
}

# Generated, one line per source file: run `pmbootstrap checksum agentd` (or `abuild checksum`)
# after copying this directory into pmaports, and again for each release tarball.
sha512sums=""
