#!/sbin/openrc-run
# agentd: the agent that runs the phone. Starts after the modem, network and audio services.

name="agentd"
description="Agentic OS phone daemon"
command="/usr/bin/agentd"
command_args="run -c ${AGENTD_CONFIG:-/etc/agentd/agentd.toml}"
# supervise-daemon restarts agentd if it dies: the phone must not stay without its agent.
supervisor="supervise-daemon"
respawn_delay=2
respawn_max=10
respawn_period=300
output_log="/var/log/agentd.log"
error_log="/var/log/agentd.log"
: ${AGENTD_PASSPHRASE_FILE:=/etc/agentd/passphrase}
export AGENTD_PASSPHRASE_FILE

depend() {
	need dbus localmount
	want modemmanager networkmanager feedbackd callaudiod
	after modemmanager networkmanager bootmisc
	use logger
}

start_pre() {
	# The model's CPU/GPU/memory priority needs the unified cgroup v2 tree.
	if [ ! -e /sys/fs/cgroup/cgroup.controllers ]; then
		ewarn "cgroup v2 is not mounted at /sys/fs/cgroup: set rc_cgroup_mode=\"unified\""
		ewarn "in /etc/rc.conf and reboot, or the LLM gets no CPU/GPU priority"
	fi
	checkpath -d -m 0700 -o root:root /var/lib/agentd
	checkpath -d -m 0700 -o root:root /etc/agentd
	# First boot: a random vault passphrase, then the vault and the MCP bearer token.
	if [ ! -s "$AGENTD_PASSPHRASE_FILE" ]; then
		einfo "Creating the vault passphrase"
		( umask 077; head -c 32 /dev/urandom | base64 > "$AGENTD_PASSPHRASE_FILE" )
	fi
	if [ ! -e /var/lib/agentd/vault.bin ] && [ ! -s /etc/agentd/gateway-token ]; then
		einfo "Creating the vault; the MCP token is in /etc/agentd/gateway-token"
		( umask 077; $command init -c "${AGENTD_CONFIG:-/etc/agentd/agentd.toml}" \
			| tail -n 1 > /etc/agentd/gateway-token ) || return 1
	fi
}
