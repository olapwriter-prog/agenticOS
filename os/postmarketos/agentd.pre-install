#!/bin/sh
# The user that runs agentd's audio session (PipeWire, callaudiod, feedbackd).
addgroup -S agentd-session 2>/dev/null
adduser -S -D -H -h /var/lib/agentd-session -s /sbin/nologin -G agentd-session \
	-g "agentd audio session" agentd-session 2>/dev/null
for g in audio video input feedbackd plugdev; do
	getent group "$g" >/dev/null && addgroup agentd-session "$g" 2>/dev/null
done
exit 0
