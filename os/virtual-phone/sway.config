# The virtual phone's screen: a portrait phone (390 x 844 points at 2x), the Agentic OS screen on
# workspace 1 and Android on workspace 2, as on the real phone (os/postmarketos/sway.config).
output * mode --custom 780x1688@60Hz scale 2 bg #07080C solid_color
default_border none
default_floating_border none
focus_follows_mouse no

# the Agentic OS screen fills workspace 1; it runs as root next to agentd (see provision.sh)
for_window [app_id="agentos-ui"] move to workspace number 1, fullscreen enable
workspace 1
exec sudo --preserve-env=XDG_RUNTIME_DIR,WAYLAND_DISPLAY AGENTD_SOCK=/run/agentd.sock /usr/local/bin/agentos-ui

# Android windows go full screen to workspace 2
for_window [app_id="Waydroid"] move to workspace number 2, fullscreen enable
for_window [title="Waydroid"] move to workspace number 2, fullscreen enable

# the Mac's keyboard types directly; the on-screen one is there for the phone feel
exec wvkbd-mobintl -H 260 --hidden

# F1 back to Agentic OS from Android, F2 shows Android (Escape stays Android's Back)
bindsym F1 workspace number 1
bindsym F2 workspace number 2
